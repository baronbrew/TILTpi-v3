[Unit]
Description=Tilt Pi (Node.js)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/TILTpi-v3/server
EnvironmentFile=-/etc/default/locale
# Same heap cap Node-RED used: keeps Node from growing into swap on 512 MB Pis (Zero W, 3A+).
Environment=NODE_OPTIONS=--max-old-space-size=256
# Fresh images soft-block Bluetooth; "+" runs this one step as root.
ExecStartPre=+-/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
# Raw HCI access for noble without running as root. Don't add a CapabilityBoundingSet: it also
# caps the sudo the app uses for reboot/shutdown/timezone/hostname/WiFi, and sudo then fails.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
